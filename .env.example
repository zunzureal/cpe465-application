# Backend API Configuration
# Backend runs on port 8080 (see backend/cpe465-server/.env for PORT)
# Database: Supabase PostgreSQL (see backend/cpe465-server/.env for DB config)
#
# For local development (web/iOS simulator):
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
#
# For network access (Expo Go on mobile, same Wi-Fi):
#   1. Run: ipconfig getifaddr en0  (on macOS)
#   2. Set: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:8080 (replace 192.168.1.x with your Mac IP)
#   3. Start backend: cd backend/cpe465-server && pnpm install && npm run dev
#   4. Restart Expo: npx expo start
#
# Note: Leave empty to use defaults (localhost:8080 for web, 10.0.2.2:8080 for Android emulator)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:8080
# Production / shared backend used by the app:
EXPO_PUBLIC_API_BASE_URL=https://project-465-service-649507438534.asia-southeast1.run.app

# For local development:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: override mock CPM device server URL (same Wi‑Fi as the phone).
# Restart Expo (`npx expo start`) after changing.
# EXPO_PUBLIC_MOCK_DEVICE_URL=http://192.168.1.10:3000
